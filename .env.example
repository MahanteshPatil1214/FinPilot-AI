# Copy this file to .env and adjust as needed. Docker Compose reads it
# automatically for the ${VAR} substitutions in docker-compose.yml.

# --- PostgreSQL (container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finpilot
# Host port for the database. Defaults to 5433 because a local PostgreSQL
# install commonly occupies 5432.
POSTGRES_HOST_PORT=5433

# --- Application ports ---
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080

# --- Backend runtime ---
# development | test | production. "production" enforces strict settings.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Optional LLM ---
# Leave empty to run fully deterministic (no external AI calls).
GROQ_API_KEY=

# --- Identity boundary ---
# development | header | jwt. "development" is a fixed demo identity and is not
# a security boundary. "header" is rejected in production. "jwt" requires a
# secret and verifies bearer tokens.
AUTH_PROVIDER=development
AUTH_JWT_SECRET=
