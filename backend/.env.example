# Backend environment. Copy to `.env` (gitignored) and adjust.
# docker-compose publishes PostgreSQL on host port 5433 to avoid clashing with
# a local PostgreSQL install on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/finpilot

# CORS origins must be a JSON list (pydantic-settings parses lists as JSON).
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Leave empty to run fully deterministic (no external AI calls).
GROQ_API_KEY=

# development | test | production. "production" enforces strict settings and
# expects the schema to exist via Alembic migrations.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Identity boundary: development | header | jwt.
AUTH_PROVIDER=development
AUTH_JWT_SECRET=

# Where uploaded source documents are stored (kept private, never served).
STORAGE_DIR=storage
